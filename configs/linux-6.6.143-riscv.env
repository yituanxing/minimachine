# Frozen Linux corpus identity.
LINUX_VERSION=6.6.143
LINUX_ARCHIVE=linux-6.6.143.tar.xz
LINUX_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.6.143.tar.xz
LINUX_SHA256=dace1f8dc9c0dbf5df14f47e3229cd62c298e83049681731ef229f2ba7592932

ARCH=riscv
KCONFIG_TARGET=defconfig

# Ubuntu 24.04 LLVM toolchain baseline.
# We intentionally pin the major toolchain family first and record the exact
# version string/hash in each generated corpus manifest.
LLVM_MAJOR=18
